{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/tools/overnight/guard.py\"", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/tools/overnight/stop_gate.py\"", "timeout": 900 }
        ]
      }
    ]
  }
}
