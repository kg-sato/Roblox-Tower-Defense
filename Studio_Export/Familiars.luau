-- the familiar behind a character folder id (nil for characters that are not in the new cast, such as Sprout)
function Familiars.forChar(charId: string): Familiar?
	for _, f in Familiars.list do
		if f.charId == charId then
			return f
		end
	end
	return nil
end

return Familiars
