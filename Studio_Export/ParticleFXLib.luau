--!nocheck
-- ParticleFXLib: plays the ParticleFX Studio catalogue by name (T29). Data: ParticleFXRegistry (generated by
-- tools/pfx_registry.py from VFX/flipbooks/particlefx_catalog.json and Overnight/asset_ids.json).
-- With an uploaded id: one particle stepping through the 8x8 sheet (Grid8x8, OneShot, Lifetime = the sheet's length,
-- Rate 0, LightInfluence 0, LockedToPart, Size by use). Without an id (or opts.noId): a FlipbookFX template with a
-- built-in texture for the same use, so nothing breaks before upload. UI entries play on an ImageLabel instead
-- (FlipbookFX.ui with the sheet, or a FrameArt glow pulse as the fallback).
-- Install as ReplicatedStorage.ParticleFXLib (+ ParticleFXRegistry). GameClient exposes it as FXK.pfx (FXK.play is the
-- sound player there).
--
--   Lib.play(name, cframe, { color, scale, size, loop, noId })  -> handle { stop() } (world)
--   Lib.ui(name, imageLabel, { noId, loop })                    -> stop()
--   Lib.names()                                                 -> every catalogue name

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local F = require(ReplicatedStorage:WaitForChild("FlipbookFX"))
local REG = require(ReplicatedStorage:WaitForChild("ParticleFXRegistry"))
F.defineDefaults()

local Lib = {}

-- fallback template per use (built-in textures through FlipbookFX)
local FALLBACK = { hit = "Sparkle", placement = "Sparkle", defeat = "Ember", ring = "Sparkle", status = "Sparkle", ultimate = "Ember", reveal = "Ember" }

local function template(name, e)
	local key = "PFX_" .. name
	local reg = F.registry()
	local t = reg:FindFirstChild(key)
	if t then
		return t
	end
	return F.define(key, {
		texture = "rbxassetid://" .. tostring(e.id),
		grid = 8,
		lifetime = e.lifetime,
		size = e.size,
		light = 1,
		zOffset = 1,
		emitCount = 1,
	})
end

function Lib.names()
	local out = {}
	for name in REG do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

function Lib.play(name: string, cf: CFrame, opts)
	opts = opts or {}
	local e = REG[name]
	if not e then
		warn("ParticleFXLib: no effect named " .. tostring(name))
		return { stop = function() end }
	end
	local scale = (opts.scale or 1) * ((opts.size and e.size > 0) and opts.size / e.size or 1)
	local tint = opts.color
	if e.id and not opts.noId then
		return F.play(template(name, e), cf, { scale = scale, color = tint, loop = opts.loop }) -- loop sheets play once unless asked
	end
	local fb = FALLBACK[e.use] or "Sparkle"
	return F.play(fb, cf, { scale = scale * math.max(e.size, 4) / 6, color = tint or Color3.fromRGB(e.tint[1], e.tint[2], e.tint[3]), loop = opts.loop })
end

function Lib.ui(name: string, label: ImageLabel, opts)
	opts = opts or {}
	local e = REG[name]
	if not e then
		return function() end
	end
	if e.id and not opts.noId then
		return F.ui(label, { image = "rbxassetid://" .. tostring(e.id), grid = 8, sheetSize = 1024, seconds = e.lifetime, loop = opts.loop })
	end
	-- fallback: a FrameArt glow that swells and fades (EditableImage works in UI)
	local ok, FA = pcall(function() return require(ReplicatedStorage:WaitForChild("FrameArt", 2)) end)
	if ok and FA then
		label.ImageContent = FA.glow()
	end
	label.ImageColor3 = Color3.fromRGB(e.tint[1], e.tint[2], e.tint[3])
	label.ImageTransparency = 0
	local tween = game:GetService("TweenService"):Create(label, TweenInfo.new(e.lifetime, Enum.EasingStyle.Quad), { ImageTransparency = 1 })
	tween:Play()
	return function()
		tween:Cancel()
	end
end

return Lib
