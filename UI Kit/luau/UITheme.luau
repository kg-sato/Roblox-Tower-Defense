--!nocheck
-- UITheme: design tokens. Every colour, font, radius and stroke weight a screen may use lives here, so a
-- screen script only names tokens ("green", "lg") and never invents numbers. This is the "style preset"
-- idea the paid UI generators sell. Presets are modelled on the reference screenshots in
-- Roblox Dev/Research (names in comments). All radii and stroke weights are SCALE (fraction of the
-- element's shortest side), never pixels.

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

