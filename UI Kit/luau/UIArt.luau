-- the image to show for a sprite, or nil if it cannot be shown on this machine
function UIArt.image(name)
	if UIArt.ids[name] then
		return UIArt.ids[name]
	end
	if UIArt.useLocal and UIArt.sprites[name] then
		return UIArt.localRoot .. name .. ".png"
	end
	return nil
end

function UIArt.has(name)
	return UIArt.sprites[name] ~= nil and UIArt.image(name) ~= nil
end

return UIArt
